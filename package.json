{
  "name": "@local/deepseek-chat-mode",
  "version": "0.2.0-beta.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DSHift: a native DeepSeek Chat mode for DeepSeek Harness, with chat-export import, long-term memory, deep thinking, web search, file upload, and persistent history.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamuelChung2010/DSHift.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "docs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "assets/demo.gif"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
